# ---------------------------------------------------------------------------
# PostHog
#
# Copy to .env.local and fill in. With no key set, analytics is a no-op and
# the site runs exactly as it did before — nothing throws.
#
# Setup, in full: docs/PLAN-analytics-and-admin.md, section 0.
# ---------------------------------------------------------------------------

# Project API key from PostHog → Settings → Project. Starts with `phc_`.
# This one is public by design: it is write-only ingestion and ships in the
# browser bundle. It cannot read your data.
NEXT_PUBLIC_POSTHOG_KEY=

# `us` or `eu`. Chosen once when the PostHog project is created and fixed
# afterwards — changing it means migrating the data. Drives the ingestion
# host, the asset host and the rewrites in next.config.mjs.
NEXT_PUBLIC_POSTHOG_REGION=eu

# Personal API key, for the admin panel's embedded dashboards in Phase 5.
# This one CAN read your data. Never give it a NEXT_PUBLIC_ prefix and never
# reference it from a client component.
POSTHOG_PERSONAL_API_KEY=


# ---------------------------------------------------------------------------
# Supabase Postgres
#
# Two URLs, and they are not interchangeable.
#
# DATABASE_URL  — Supavisor pooler, port 6543. Everything at runtime.
#                 Serverless opens a connection per invocation; without the
#                 pooler Postgres runs out of connections under real traffic.
# DIRECT_URL    — direct connection, port 5432. Migrations only.
#                 DDL cannot run through a transaction-mode pooler.
#
# Supabase → Project Settings → Database → Connection string.
# Choose region ap-south-1 (Mumbai) — readers and functions should both be
# near the data.
# ---------------------------------------------------------------------------

DATABASE_URL=
DIRECT_URL=


# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------

# Signs the session cookie. Generate with:  openssl rand -base64 32
# Rotating this invalidates every active session, so treat it as permanent.
AUTH_SECRET=

# The canonical origin. Required in production so OAuth callbacks and magic
# links point at the real site rather than at localhost.
AUTH_URL=http://localhost:3000

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials.
# Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend, for magic links and newsletter confirmations. resend.com/api-keys
# The from-address domain must be verified in Resend or delivery silently fails.
AUTH_RESEND_KEY=
EMAIL_FROM="Human Signals <hello@yourdomain.com>"


# ---------------------------------------------------------------------------
# Admin panel (Phase 3)
# ---------------------------------------------------------------------------

# Authenticates the Vercel Cron → /api/admin/publish-scheduled route.
# Generate with:  openssl rand -base64 32
# Set this same value in Vercel → Settings → Environment Variables.
# The cron route returns 401 if this is missing or wrong.
CRON_SECRET=


# ---------------------------------------------------------------------------
# Razorpay (Phase 4)
#
# Test credentials: dashboard.razorpay.com → Settings → API Keys → Test mode
# Live credentials: same screen, switch to Live mode (requires KYC approval)
#
# RAZORPAY_KEY_ID starts with rzp_test_ (test) or rzp_live_ (live).
# It is safe to expose in the browser — the Checkout SDK needs it.
#
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are server-only.
# Never prefix them with NEXT_PUBLIC_.
#
# Webhook endpoint to register in the Razorpay dashboard:
#   https://yourdomain.com/api/webhooks/razorpay
# Events to subscribe: payment.captured, payment.failed, order.paid,
#   subscription.activated, subscription.charged, subscription.halted,
#   subscription.cancelled, refund.processed
# ---------------------------------------------------------------------------

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to true once the business is GST-registered and the accountant has
# reviewed the invoice format. Flipping this requires no code change.
RAZORPAY_COLLECT_GST=false

# Your GSTIN — required when RAZORPAY_COLLECT_GST=true. Leave blank until
# registration is complete.
GSTIN=


# ---------------------------------------------------------------------------
# Sentry (Phase 6)
#
# 1. Create a project at sentry.io (Next.js platform).
# 2. Copy the DSN from Settings → Client Keys.
# 3. Create an auth token at sentry.io/settings/auth-tokens/ with
#    project:releases and org:read scopes. Used for source map upload.
#
# Until these are set the site runs fine — lib/sentry.ts stubs out the calls
# and logs to the Vercel function log instead.
# ---------------------------------------------------------------------------

# Public: used in the browser error boundary (client-side captures).
NEXT_PUBLIC_SENTRY_DSN=

# Server-only: used in lib/sentry.ts for server-side captures.
# Never give this a NEXT_PUBLIC_ prefix.
SENTRY_DSN=

# Required at BUILD TIME for source map upload. Set in Vercel build settings,
# not in runtime environment variables.
SENTRY_AUTH_TOKEN=

# Org and project slugs, read by @sentry/nextjs during build.
SENTRY_ORG=
SENTRY_PROJECT=
